<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB-OTG to a Proxmark. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- BLE for the Proxmark5 BWM. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Bluetooth classic (Blueshark) and BLE (BWM). The legacy permissions are
         still required below API 31, where the new split permissions do not
         exist; maxSdkVersion keeps them off newer installs. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE scanning. usesPermissionFlags="neverForLocation" is accurate: the
         app matches on the BWM's service UUID and never derives location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Below API 31 a BLE scan is gated on location permission regardless. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional: lets the app install its `pm3` wrapper into Termux and open
         sessions there. The app is fully usable without Termux installed. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Loopback only; declared because the bridge opens a ServerSocket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".Pm3Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pm3"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to launch when a Proxmark is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".bridge.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
